# Copy to .env (git-ignored). Fill only what you need. Never commit real keys.

# Live AI (investigator, Guardy chat, dashboard Ask box). Free key: https://build.nvidia.com
# Without it, run with --ai fixture (canned answers).
NVIDIA_API_KEY=

# Real PayPal sandbox (Log in with PayPal + Payouts). From developer.paypal.com > Apps & Credentials > Sandbox.
# Not needed for demo mode, which simulates PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Name and country from Log in with PayPal (needed for the name and country mismatch flags).
# The PayPal sandbox app must also have the Profile and Address attributes enabled.
RESCUE_PAYPAL_SCOPES="openid profile address https://uri.paypal.com/services/paypalattributes"

# Optional
# RESCUE_DASHBOARD_MODEL=      # a different NVIDIA model for the dashboard Ask box (default: the small core model)
RESCUE_STUDIO_MODEL=deepseek-ai/deepseek-v4.1-flash   # NVIDIA model behind the AG Studio AI Assistant chat (same NVIDIA key). Add ?studioTools=0 to the dashboard URL to use the faster small-model picker instead
# RESCUE_FAST_LANE=on          # let clean changes skip manual review (the safety wait still runs)
# RESCUE_PUBLIC_ORIGIN=https://your.host   # when served behind HTTPS
