{
 "info": {
  "name": "Payout Rescue destination API \u2014 disposable fixture",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "variable": [
  {
   "key": "baseUrl",
   "value": "http://127.0.0.1:8765"
  }
 ],
 "event": [
  {
   "listen": "prerequest",
   "script": {
    "type": "text/javascript",
    "exec": [
     "if(pm.variables.get(\"baseUrl\")!==\"http://127.0.0.1:8765\"){throw new Error(\"Disposable local fixture only\");}"
    ]
   }
  }
 ],
 "item": [
  {
   "name": "Confirm isolated fixture",
   "request": {
    "method": "GET",
    "url": "{{baseUrl}}/api/session",
    "header": [
     {
      "key": "X-CSRF-Token",
      "value": "{{csrf}}"
     },
     {
      "key": "Idempotency-Key",
      "value": "pg-request-1"
     }
    ]
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
       "if(pm.response.code!==200){pm.execution.setNextRequest(null);throw new Error(\"Unexpected status\");}",
       "const d=pm.response.json(); if(d.mode!==\"demo\"||d.ai_mode!==\"scripted demo\"){pm.execution.setNextRequest(null);throw new Error(\"Requires isolated demo\");}"
      ]
     }
    }
   ]
  },
