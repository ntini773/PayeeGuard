    }
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
       "if(pm.response.code!==201){pm.execution.setNextRequest(null);throw new Error(\"Unexpected status\");}",
       "const d=pm.response.json(); pm.collectionVariables.set(\"caseId\",d.case_id); pm.test(\"Held pending request\",()=>{pm.expect(d.state).to.eql(\"CHANGE_REQUESTED\");pm.expect(d.payout_control.proposed_destination_usable).to.eql(false);});"
      ]
     }
    }
   ]
