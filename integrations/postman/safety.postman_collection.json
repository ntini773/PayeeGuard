{
  "info": {
    "name": "Payout Rescue \u2014 isolated safety regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8765"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.variables.get(\"baseUrl\")!==\"http://127.0.0.1:8765\"){throw new Error(\"Local isolated fixture only\");}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Require isolated demo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{baseUrl}}/api/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Unexpected status; stopping fixture run\"); }",
              "const d=pm.response.json(); pm.test(\"Synthetic fixture only\",()=>{pm.expect(d.mode).to.eql(\"demo\");pm.expect(d.ai_mode).to.eql(\"scripted demo\");}); if(d.mode!==\"demo\" || d.ai_mode!==\"scripted demo\"){pm.execution.setNextRequest(null);throw new Error(\"Requires fixture demo\");}"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous case denied",
